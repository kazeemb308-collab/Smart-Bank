<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Smart Bank | Login</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <div class="app">
    <div class="topbar">
      <div class="brand">
        <div class="logo">SB</div>
        <div>
          <div class="app-title">Smart Bank</div>
          <div class="muted">Login</div>
        </div>
      </div>
      <div></div>
    </div>

    <div class="card form-card">
      <% if (error) { %><p class="error"><%= error %></p><% } %>
      <% if (success) { %><p class="success"><%= success %></p><% } %>
      <form action="/login" method="POST">
        <label>Email</label>
        <input type="email" name="email" required />

        <label>Password</label>
        <input type="password" name="password" required />

        <button type="submit">Log in</button>
      </form>
      <p class="muted">Demo admin: admin@smartbank.com / Admin@1234</p>
      <p class="muted"><a class="muted" href="/register">Open an account</a></p>
    </div>

    <div class="footer-nav">
      <div class="nav-item">Help</div>
      <div class="nav-item">Contact</div>
      <div class="nav-item">Privacy</div>
    </div>
  </div>
</body>
</html>
