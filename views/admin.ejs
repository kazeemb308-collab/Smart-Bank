<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Smart Bank | Admin</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <div class="app">
    <div class="topbar">
      <div class="brand">
        <div class="logo">SB</div>
        <div>
          <div class="app-title">Admin Console</div>
          <div class="muted">Manage accounts</div>
        </div>
      </div>
      <div><a class="muted" href="/dashboard">Back</a></div>
    </div>

    <div class="card">
      <div class="section-title"><strong>Admin Dashboard</strong><span class="muted">Overview</span></div>
      <div class="stat-row">
        <div>
          <strong>Customers</strong>
          <div><%= adminStats.customerCount %></div>
        </div>
        <div>
          <strong>Total customer balance</strong>
          <div>$<%= Number(adminStats.totalCustomerBalance).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 6 }) %></div>
        </div>
      </div>
      <div class="stat-row" style="margin-top:12px">
        <div>
          <strong>Total interest paid</strong>
          <div>$<%= Number(adminStats.totalInterestPaid).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 6 }) %></div>
        </div>
        <div>
          <strong>Transactions today</strong>
          <div><%= adminStats.transactionsToday %></div>
        </div>
      </div>
    </div>

    <div class="card form-card">
      <div class="section-title"><strong>Credit Customer</strong></div>
      <% if (error) { %><p class="error"><%= error %></p><% } %>
      <% if (success) { %><p class="success"><%= success %></p><% } %>
      <form action="/admin/fund" method="POST">
        <label>Account Number</label>
        <input type="text" name="account_number" required />

        <label>Amount</label>
        <input type="number" name="amount" step="0.01" min="1" required />

        <label>Description</label>
        <input type="text" name="note" placeholder="Reason for credit (e.g., bonus, refund)" required />

        <button type="submit">Credit Account</button>
      </form>
    </div>

    <div class="card">
      <div class="section-title"><strong>Customers & Interest Rates</strong></div>
      <div class="tx-list">
        <% users.forEach((user) => { %>
          <div class="tx" style="flex-direction:column;align-items:stretch;gap:10px">
            <div style="display:flex;align-items:center;gap:10px">
              <div class="icon"><%= ((user.full_name || 'U').split(' ')[0] || 'U').charAt(0) %></div>
              <div class="meta">
                <div><strong><%= user.full_name %></strong></div>
                <div class="muted"><%= user.account_number %> • $<%= Number(user.balance).toLocaleString() %></div>
                <div class="muted" style="font-size:12px">
                  Current daily rate: <%= (Number(user.interest_rate || 0) * 100).toFixed(3) %>%
                </div>
              </div>
              <div class="muted" style="font-size:12px;margin-left:auto"><%= user.is_admin ? 'Admin' : 'Customer' %></div>
            </div>

            <form action="/admin/interest-rate" method="POST" style="display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap">
              <input type="hidden" name="account_number" value="<%= user.account_number %>" />
              <div style="flex:1;min-width:140px">
                <label style="font-size:12px">New daily rate (%)</label>
                <input type="number" name="interest_rate" step="0.001" min="0"
                       value="<%= (Number(user.interest_rate || 0) * 100).toFixed(3) %>" required />
              </div>
              <button type="submit">Update Rate</button>
            </form>
          </div>
        <% }) %>
      </div>
    </div>

    <div class="card form-card">
      <div class="section-title"><strong>Reply to Customer</strong></div>
      <form action="/admin/reply" method="POST">
        <label>Account Number</label>
        <input type="text" name="account_number" placeholder="1234567890" required />

        <label>Reply Message</label>
        <textarea name="message" rows="4" placeholder="Write your reply here" required></textarea>

        <button type="submit">Send Reply</button>
      </form>
    </div>

    <div class="card">
      <div class="section-title"><strong>Support Conversations</strong></div>
      <div class="tx-list">
        <% users.forEach((user) => { %>
          <%
            let userMessages = [];
            try {
              userMessages = Array.isArray(messagesByUser && messagesByUser[user.id]) ? messagesByUser[user.id] : [];
            } catch (err) {
              userMessages = [];
            }
          %>
          <div class="tx" style="flex-direction:column;align-items:flex-start;gap:6px">
            <div style="display:flex;align-items:center;gap:10px;width:100%">
              <div class="icon"><%= ((user.full_name || 'U').split(' ')[0] || 'U').charAt(0) %></div>
              <div class="meta">
                <div><strong><%= user.full_name || 'Unknown user' %></strong></div>
                <div class="muted"><%= user.account_number || '' %></div>
              </div>
            </div>
            <% if (userMessages.length) { %>
              <div class="chat-thread compact">
                <% userMessages.forEach((msg) => { %>
                  <div class="chat-bubble <%= msg.sender === 'admin' ? 'admin' : 'customer' %>">
                    <div class="chat-meta">
                      <strong><%= msg.sender === 'admin' ? 'Customer Care' : 'Customer' %></strong>
                      <span><%= new Date(msg.created_at).toLocaleString() %></span>
                    </div>
                    <div class="chat-message"><%= msg.message %></div>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <div class="muted">No support messages yet.</div>
            <% } %>
          </div>
        <% }) %>
      </div>
    </div>

    <div class="card">
      <div class="section-title"><strong>Recent Transactions</strong></div>
      <div class="tx-list">
        <% transactions.forEach((tx) => { %>
          <div class="tx">
            <div class="icon">T</div>
            <div class="meta"><div><strong><%= tx.type %></strong></div><div class="muted"><%= tx.note %></div></div>
              <div class="amount">$<%= Number(tx.amount).toLocaleString() %></div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</body>
</html>
